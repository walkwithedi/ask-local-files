#!/bin/sh
# Scans every commit on a local branch that no remote has yet (messages, identities, added
# lines, image and document metadata); a finding stops the push.
# Enabled together with pre-commit by:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
if command -v python3 >/dev/null 2>&1; then PY=python3; else PY=python; fi
exec "$PY" scripts/sensitive_scan.py --unpushed
